# Copy to .env.local and fill in. Without these the site runs on the committed seed —
# the same tariff the migration seeds into Postgres — so a checkout with no credentials
# still renders real prices.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The anon key is public by design and safe in the browser: RLS decides what it can read.
# The service-role key bypasses RLS entirely and must NEVER appear here or in any
# NEXT_PUBLIC_* variable (non-negotiable #7).
#
# These two are also all the staff console needs. It signs in with the same anon key and carries
# the member of staff's own session, so their role's RLS policies are what filter every query —
# there is deliberately no privileged key behind the console.

# Canonical origin, used for metadata, hreflang alternates and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://thesisters-ns.dz

# Fills the staff console with example clients, appointments, messages and collaborations so it
# can be looked at before a database exists (§14: an empty app cannot be evaluated). Set to 1.
#
# It has NO effect once NEXT_PUBLIC_SUPABASE_URL is set — real data always wins, and there is no
# way to override that. Every console screen carries a banner saying the data is fictional.
# The public site never shows any of it.
NEXT_PUBLIC_DEMO_DATA=

# WhatsApp Business Cloud API. Leave both blank and the manual adapter runs instead: bookings
# still work end to end, and reception gets a record of what to send by hand. Nothing in the
# core blocks on Meta approval (§10).
# Server-only — never prefix these with NEXT_PUBLIC_.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
